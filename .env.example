# Public configuration for a SEPARATE AudioGraffiti Firebase project.
# Never copy IssueTrax's production configuration or put AI secrets in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=false

# Optional local-development speech-to-text; never prefix this secret with VITE_.
OPENAI_API_KEY=

# Hosted private preview: set these in Render's environment, not in the client.
PREVIEW_USERNAME=preview
PREVIEW_PASSWORD=
# Render supplies RENDER_EXTERNAL_URL. Override only for a custom domain/local server.
PUBLIC_ORIGIN=
